# Copy to .env (gitignored) and fill in. Never commit real values.
LOCALSTACK_AUTH_TOKEN=
LTA_API_KEY=
ONEMAP_API_KEY=
ONEMAP_API_EMAIL=
ONEMAP_API_PASSWORD=
ONEMAP_BASE_URL=https://www.onemap.gov.sg
# Journey Service step photos (Google Street View Static API). Empty = no Street View photos.
GOOGLE_MAPS_API_KEY=
# Easy-read Service: the Ollama model for "Simplify with AI" (local compose). A bigger one (e.g. llama3.2:3b)
# writes better text if your machine has the memory.
# OLLAMA_MODEL=qwen2.5:1.5b
# Journey Service demo data: the local compose setup defaults both to "recorded" (saved API responses, no keys needed).
# Uncomment to use the real APIs (needs LTA_API_KEY and the OneMap account above, or a pasted ONEMAP_API_KEY that hasn't expired).
# ONEMAP_MODE=live
# LTA_MODE=live
