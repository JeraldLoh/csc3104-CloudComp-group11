# Copy to .env (gitignored) and fill in. Never commit real values.
LOCALSTACK_AUTH_TOKEN=

# For Journey Service: OneMap and LTA API keys (for live mode) and a OneMap account (for live mode), and Google Maps API key for Street View.
LTA_API_KEY=
ONEMAP_API_KEY=
ONEMAP_API_EMAIL=
ONEMAP_API_PASSWORD=
ONEMAP_BASE_URL=https://www.onemap.gov.sg
GOOGLE_MAPS_API_KEY=
EASYREAD_MAX_CHARS=300 # For easy-read wording, the maximum number of characters to use for a step's description. 300 is a good default.
